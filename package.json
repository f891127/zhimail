{
  "name": "zhimail",
  "productName": "智邮",
  "version": "1.4.8",
  "private": true,
  "description": "智能桌面邮件客户端，内置AI汇总、简报与待办能力。",
  "author": {
    "name": "fxj"
  },
  "license": "MIT",
  "main": "dist-electron/main.js",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "overrides": {
      "iconv-lite": "^0.6.3"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "pnpm notes && pnpm build:renderer && pnpm build:electron",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "node --test tests/ 2>/dev/null || echo \"no tests\"",
    "screenshot": "ZHIMAIL_SCREENSHOT=1 electron .",
    "dist:win": "pnpm build && electron-builder --win nsis --x64",
    "dist:zip": "pnpm build && electron-builder --win zip --x64",
    "notes": "node scripts/release-notes.mjs > release-notes.md"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "docx": "^9.15.3",
    "electron-updater": "^6.8.11",
    "html-to-text": "^9.0.5",
    "iconv-lite": "^0.6.3",
    "imapflow": "^1.0.164",
    "jszip": "^3.10.2",
    "mailparser": "^3.7.1",
    "mammoth": "^1.13.0",
    "nodemailer": "^6.9.16",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "marked": "^14.1.3",
    "pdfjs-dist": "4.10.38",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "zustand": "^5.0.1"
  }
}
